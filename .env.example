# Database URL (Default SQLite for local; or PostgreSQL for remote serverless)
DATABASE_URL="file:./dev.db"

# Payment Gateway Mode: "manual" (Direct UPI QR)
PAYMENT_MODE=manual

# Manual UPI Details
MERCHANT_VPA="6380640087@upi"
MERCHANT_NAME="ZeroToTenK Digital"

# Admin Authentication
ADMIN_PASSWORD="your-secure-admin-password"

# Security & Sessions
NEXTAUTH_SECRET="generate-a-32-char-random-secret"

# Public App URL (Your Vercel deployment URL or custom domain)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
